use std::fmt::Display;
//___________Trait_Einrichten____________________
trait GroessenVergleich	{
	fn groessenvergleich (self)->bool where Self:Sized+Display{  //damit self in print! (bei .auswertung()) verwendet werden kann gilt Self:Sized+Display
	    self.typangabe().wertausgabe().auswertung()              //Dreifache Verkettung von Methoden
	}                                                            //Bedingt übergabe von self bis .auswertung()
	fn typangabe (self)->Self;                                   //Rückgabe von Self für übergabe an .wertausgabe()
	fn auswertung(self)->bool;                                   //Rückgabe von bool für übergabe an .groessenvergleich()
	fn wertausgabe (self)->Self where Self:Sized+Display {       //Rückgabe von Self für übergabe an .auswertung()
	    print!("ist der Wert {} ",self);                         //damit self in print! verwendet werden kann gilt Self:Sized+Display
	    self                                                     //Funktionsrückgabe (self)
	}
}
//___________Implementierungen_U8-U128___________
impl GroessenVergleich for u8 {
	fn typangabe (self)->Self{                                   //Definition .typenangabe in jeder Implementation da in trait kein Scope
		print!("Im Wertebereich von U8 ");
		self                                                       //Funktionsrückgabe (self)
	}
	fn auswertung (self)->bool {
		if self >= (2_u8.pow(7)-1) {                               //u8 sind Werte von 0-255. Die Mitte liegt bei 127 (2^7-1)
		println!("groß");
		true                                                       //Funktionsrückgabe true
		}
		else {
		println!("klein");
		false                                                      //Funktionsrückgabe false
		}
	}
}
