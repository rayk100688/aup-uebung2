//__________Trait_anlegen__________
trait Power {
	fn power (self,exp:u32)->Self;    //Muss in jeder Implementierung definiert werden (kein Scope)
}
//__________Imlementierungen_______
impl Power for u64 {
	fn power (self,exp:u32)->Self{    //Rekursive Funktion
		if exp>0 {
		self*self.power(exp-1)
		} 
		else{
		1                               //Rückgabe bei Abbruch der Rekursion als u64-kompatibel
		}
	}
}
impl Power for f64 {
	fn power (self,exp:u32)->Self{
		if exp>0 {
		self*self.power(exp-1)
		} 
		else{
		1.0                            //Rückgabe bei Abbruch der Rekursion als f64-kompatibel
		}
	}
}
//__________Main___________________
fn main (){
    println!("{}",5.power(3));
    println!("{}",5.3_f64.power(3));
}
