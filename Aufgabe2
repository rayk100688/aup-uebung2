//Ich benutze das Konzept der Traits aus der Vorlesung

trait PrintType {                                            //Trait wird angelegt
	fn print_type (self) where Self: Sized {                   //Erstellen der Funktion print_type in allgemeiner Form
	print! ("Hi, ich bin ein primitiver Typ: ");               //Bei jedem Aufruf erfolgt die Textausgabe (ohne Zeilenwechsel)
	self.antwort();                                            //Bei jedem Aufruf wird die Funktion antwort aufgerufen
	}
	fn antwort (self);                                         //Erstellen der Funktion antwort in Allgemeinform im Trait
}
//__________Implementierungen_U8-U128_______________
impl PrintType for u8 {                                      //Bei Aufruf mit einem U8-Typ wird diese Implementierung ausgeführt
	fn antwort (self){                                         //Funktionsdefinition von Antwort für die Implementierung U8 des Traits 
	println!("U8");                                            //In dieser Implementierung schreibe U8 (mit Zeilenwechsel)
	}                                                          //Analog erfolgt die Implementierung für alle weiteren Typen
}
impl PrintType for u16 {
	fn antwort (self){
	println!("U16");
	}
}
impl PrintType for u32 {
	fn antwort (self){
	println!("U32");
	}
}
impl PrintType for u64 {
	fn antwort (self){
	println!("U64");
	}
}
impl PrintType for u128 {
	fn antwort (self){
	println!("U128");
	}
}
